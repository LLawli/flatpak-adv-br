#!/usr/bin/env bash
# Constrói, assina e publica o aplicativo no repositório do projeto.
#
#   bin/publicar              constrói e assina no repositório local
#   bin/publicar --enviar     e manda para o servidor
#
# O repositório fica em ~/.local/share/adv-br-repo e é o que o servidor serve.
# A chave privada de assinatura NUNCA sai desta máquina: o que atravessa a rede
# é o resultado assinado, e o servidor não precisa saber assinar nada.
#
# Por que existe: até aqui o único jeito de instalar era clonar e construir,
# com flatpak-builder, o SDK do GNOME e mais de 1 GB de cache, para um pacote
# de 18 MB. Isso continua valendo para quem quiser (./instalar.sh), mas não
# pode ser a única porta.
#
# O que NÃO entra aqui, e o motivo, porque a pergunta volta: os drivers
# proprietários e o PJeOffice. Nenhum deles é redistribuível, e o modelo do
# aplicativo é justamente esse, cada um é baixado da origem oficial na máquina
# de quem usa. O que vai junto do repositório são os componentes de p11-kit,
# que são BSD-3-Clause e compilados por bin/compilar-p11kit.
set -euo pipefail

RAIZ=$(cd "$(dirname "$0")/.." && pwd)
MANIFESTO=$RAIZ/dev.lukakuuhaku.AdvBr.yml
APP_ID=dev.lukakuuhaku.AdvBr
REPO=${ADV_BR_REPO:-${XDG_DATA_HOME:-$HOME/.local/share}/adv-br-repo}
TRABALHO=${ADV_BR_TRABALHO:-${XDG_CACHE_HOME:-$HOME/.cache}/adv-br-publicacao}
CHAVE=${ADV_BR_CHAVE_GPG:-}
DESTINO=${ADV_BR_VPS:-}
ORIGEM=${ADV_BR_ORIGEM_PUBLICA:-https://flatpak.lukakuuhaku.dev}
RAMO=${ADV_BR_RAMO:-master}

erro() { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }
passo() { printf '\033[1;36m ▸\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m ✓\033[0m %s\n' "$*"; }

ENVIAR=nao
for argumento in "$@"; do
    case $argumento in
        --enviar) ENVIAR=sim ;;
        *) erro "argumento desconhecido: $argumento" ;;
    esac
done

# O builder vem de dois jeitos, e os dois servem: instalado no sistema ou como
# Flatpak. O instalar.sh já aceitava ambos; aqui só aceitava o do sistema, o
# que obrigava a instalar no host quem só queria publicar.
if command -v flatpak-builder >/dev/null; then
    construtor=(flatpak-builder)
elif flatpak info org.flatpak.Builder >/dev/null 2>&1; then
    construtor=(flatpak run org.flatpak.Builder)
else
    erro "falta o flatpak-builder. Instale-o:
      Fedora: sudo dnf install flatpak-builder
      Debian: sudo apt install flatpak-builder
      Arch:   sudo pacman -S flatpak-builder
      ou, sem tocar no sistema:
              flatpak install --user flathub org.flatpak.Builder"
fi
command -v ostree >/dev/null 2>&1 ||
    erro "falta o ostree, que é quem assina as refs deste repositório.
      Fedora: sudo dnf install ostree
      Debian: sudo apt install ostree
      Arch:   sudo pacman -S ostree"
[ -n "$CHAVE" ] || erro "defina ADV_BR_CHAVE_GPG com o id da chave de assinatura.
     Sem assinatura, quem instalar não tem como saber que o pacote é seu.
     Para criar uma:  gpg --quick-generate-key 'adv-br <voce@exemplo>' default sign never"
gpg --list-secret-keys "$CHAVE" >/dev/null 2>&1 ||
    erro "não achei a chave privada $CHAVE neste computador."

# A chave pública versionada é a segunda fonte de confiança deste repositório.
# A primeira, o .flatpakrepo, é servida pelo mesmo domínio que serve os
# pacotes: quem controlasse o servidor trocaria as duas de uma vez. A que está
# aqui viaja pelo git, num histórico de commits assinados, onde uma troca deixa
# rastro.
#
# Duas cópias da mesma chave viram mentira no dia em que uma desatualiza, e é
# por isso que publicar confere as duas antes de qualquer outra coisa: assinar
# com uma chave que o repositório não anuncia produz um repositório que ninguém
# instala, e o erro que aparece do outro lado fala de referência inexistente,
# não de assinatura.
CHAVE_PUBLICA=$RAIZ/packaging/chave-publica.asc
[ -f "$CHAVE_PUBLICA" ] ||
    erro "falta $CHAVE_PUBLICA, a chave pública que o repositório anuncia.
     Para gerar:  gpg --export --armor \"\$ADV_BR_CHAVE_GPG\" > packaging/chave-publica.asc"
impressao_arquivo=$(gpg --show-keys --with-colons "$CHAVE_PUBLICA" 2>/dev/null |
    awk -F: '/^fpr/{print $10; exit}')
impressao_usada=$(gpg --list-keys --with-colons "$CHAVE" 2>/dev/null |
    awk -F: '/^fpr/{print $10; exit}')
[ -n "$impressao_arquivo" ] && [ -n "$impressao_usada" ] ||
    erro "não consegui ler a impressão digital das chaves para comparar."
[ "$impressao_arquivo" = "$impressao_usada" ] ||
    erro "a chave que você está usando não é a que o repositório anuncia.
     no repositório: $impressao_arquivo
     em uso:         $impressao_usada
     Se a troca é intencional, atualize packaging/chave-publica.asc; quem já
     tem o remoto configurado vai precisar readicioná-lo de qualquer forma."

# ---------------------------------------------------------------------------
passo "Construindo o $APP_ID"
mkdir -p "$TRABALHO"
"${construtor[@]}" --force-clean --disable-rofiles-fuse \
    --repo="$REPO" \
    --default-branch="$RAMO" \
    "$TRABALHO/base" "$MANIFESTO" >/dev/null

# ---------------------------------------------------------------------------
# A ordem aqui é o que faz o repositório ser instalável, e ela não é óbvia.
#
# Numa instalação nova, o cliente NÃO baixa o commit solto: ele usa o delta
# estático de origem vazia, que carrega dentro de si uma cópia do commit feita
# no instante em que o delta foi gerado. Assinar depois de gerar os deltas
# deixa a assinatura no repositório, correta e inútil: o commitmeta está lá, o
# cliente não o pede, e a instalação morre com "GPG verification enabled, but
# no signatures found". Nada no lado de quem publica denuncia isso.
#
# Por isso: primeiro uma passada que só cria o appstream, depois a assinatura
# de tudo, e só então os deltas e o summary.

passo "Preparando as refs do repositório"
# Sem deltas e sem assinar: esta passada existe para o appstream nascer, já que
# ele não existe antes de alguém gerar o repositório e é uma ref como as outras.
flatpak build-update-repo "$REPO" >/dev/null

passo "Assinando as refs, aqui fora"
# A assinatura NÃO é pedida ao flatpak-builder de propósito. Quando ele é o
# org.flatpak.Builder, que é um Flatpak, o build roda num sandbox sem pinentry
# e sem o socket do gpg-agent: a assinatura falha com "GPG Agent: No pinentry",
# mensagem que não menciona sandbox nenhum e manda procurar no lugar errado.
# Assinar aqui fora vale para os dois construtores, e é o único jeito quando a
# chave mora num cartão, porque quem fala com o cartão é o agent desta sessão.
#
# Pelo ostree, e não pelo `flatpak build-sign`: build-sign só entende refs de
# aplicativo e de runtime, e ignora em silêncio as de appstream, que são
# justamente as que o cliente baixa primeiro.
assinar_pendentes() {
    pendentes=0
    while IFS= read -r ref; do
        [ -n "$ref" ] || continue
        commit=$(ostree --repo="$REPO" rev-parse "$ref")
        # A assinatura mora nos metadados destacados do commit. Perguntar por
        # eles é estável; procurar a palavra "signature" na saída depende do
        # idioma em que o ostree foi traduzido.
        if ostree --repo="$REPO" show --print-detached-metadata-key=ostree.gpgsigs \
                "$commit" >/dev/null 2>&1; then
            continue
        fi
        # Avisa na tela antes de cada assinatura. Com a chave num cartão, o
        # que acontece aqui é a YubiKey piscando e esperando um toque, sem nada
        # no terminal: quem não estiver olhando para a chave perde a janela de
        # tempo, e o erro que aparece é "SCD: Tempo limite", que não menciona
        # toque nenhum. A notificação é opcional de propósito, para o publicar
        # continuar funcionando onde não há sessão gráfica.
        command -v notify-send >/dev/null 2>&1 &&
            notify-send -u normal -t 30000 \
                -h string:x-canonical-private-synchronous:advbr \
                "Toque na YubiKey" "Assinando $ref" 2>/dev/null
        ostree --repo="$REPO" gpg-sign "$commit" "$CHAVE" >/dev/null ||
            erro "não consegui assinar $ref (toque não recebido a tempo?)"
        pendentes=$((pendentes + 1))
    done < <(ostree --repo="$REPO" refs)
}

assinar_pendentes
assinadas=$pendentes

passo "Gerando os deltas, já sobre o que está assinado"
# Os deltas são o que faz uma atualização baixar poucos MB em vez do pacote
# inteiro. Sem eles, cada versão nova custa 18 MB a cada pessoa.
atualizar() {
    # O summary também é assinado, então aqui vem outro toque.
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -u normal -t 30000 \
            -h string:x-canonical-private-synchronous:advbr \
            "Toque na YubiKey" "Assinando o summary do repositório" 2>/dev/null
    flatpak build-update-repo "$REPO" \
        --gpg-sign="$CHAVE" \
        --generate-static-deltas \
        --prune --prune-depth=3 \
        --title="Certificado Digital (adv-br)" >/dev/null
}
atualizar

# Se esta passada recriou alguma ref (o appstream muda quando o repositório
# muda), ela nasceu sem assinatura e os deltas dela seriam inúteis. Assina e
# refaz uma única vez: se ainda faltar, é problema novo e o guarda abaixo pega.
assinar_pendentes
if [ "$pendentes" -gt 0 ]; then
    assinadas=$((assinadas + pendentes))
    atualizar
fi

# Guarda final, contra um mínimo absoluto e não contra outra contagem tirada da
# mesma fonte: um build que não exportou nada passaria calado por tudo acima.
total=0
faltando=0
while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    total=$((total + 1))
    commit=$(ostree --repo="$REPO" rev-parse "$ref")
    ostree --repo="$REPO" show --print-detached-metadata-key=ostree.gpgsigs \
        "$commit" >/dev/null 2>&1 || { faltando=$((faltando + 1)); printf '   sem assinatura: %s\n' "$ref"; }
done < <(ostree --repo="$REPO" refs)
[ "$total" -ge 1 ] || erro "nenhuma ref no repositório. O build exportou alguma coisa?"
[ "$faltando" -eq 0 ] || erro "$faltando ref(s) sem assinatura: o repositório não instalaria."
ok "$total ref(s), todas assinadas ($assinadas nesta rodada)"

# ---------------------------------------------------------------------------
passo "Componentes que acompanham o repositório"
# Os que este projeto pode redistribuir, e por isso compila: o p11-kit das
# séries que o host pode ter (BSD-3-Clause, bin/compilar-p11kit) e o RemoteID
# (GPLv3, bin/compilar-remoteid). Os drivers proprietários e o PJeOffice
# continuam sendo baixados da origem oficial na máquina de quem usa.
mkdir -p "$REPO/componentes"
for arquivo in "$RAIZ"/dist/p11kit-*.tar.gz "$RAIZ"/dist/remoteid-*.tar.gz; do
    [ -e "$arquivo" ] || continue
    cp -f "$arquivo" "$REPO/componentes/"
done

# E a conferência que importa: TODO componente que o catálogo espera deste
# domínio precisa estar aqui, com o sha256 que está escrito lá.
#
# Sem isto, publicar com um dist/ incompleto produz um repositório que instala
# e um componente que dá 404; e enviar um tarball recompilado sem atualizar o
# catálogo produz um download que a pessoa baixa inteiro e o aplicativo recusa.
# Os dois só apareceriam do outro lado, na máquina de quem tentou instalar.
python3 - "$RAIZ" "$REPO/componentes" "$ORIGEM" <<'CONFERE' || erro "componentes faltando ou fora do catálogo"
import hashlib
import os
import sys

raiz, destino, origem = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, os.path.join(raiz, "ui"))
import catalogo  # noqa: E402

prefixo = origem + "/componentes/"
esperados = []
for componente in catalogo.CATALOGO:
    pares = [(f.url, f.sha256) for f in componente.fontes]
    if componente.url:
        pares.append((componente.url, componente.sha256))
    for url, sha in pares:
        if url.startswith(prefixo):
            esperados.append((url[len(prefixo):], sha))

# Piso absoluto: um catálogo lido errado não pode virar "nada a conferir".
if len(esperados) < 4:
    sys.exit("esperava ao menos 4 componentes do próprio domínio, achei %d"
             % len(esperados))

faltando = []
for nome, sha in esperados:
    caminho = os.path.join(destino, nome)
    if not os.path.exists(caminho):
        faltando.append("%s: não está em dist/" % nome)
        continue
    with open(caminho, "rb") as arquivo:
        obtido = hashlib.sha256(arquivo.read()).hexdigest()
    if obtido != sha:
        faltando.append("%s: sha256 %s, e o catálogo diz %s" % (nome, obtido, sha))
    else:
        print("   ok  %s" % nome)

for linha in faltando:
    print("   " + linha, file=sys.stderr)
sys.exit(1 if faltando else 0)
CONFERE

# ---------------------------------------------------------------------------
passo "Arquivo que as pessoas adicionam"
# A chave pública vai DENTRO do .flatpakrepo, em base64. É o que permite ao
# flatpak verificar as assinaturas sem que ninguém precise importar chave à
# mão, e é também o que torna o arquivo o único ponto de confiança: quem o
# baixa por HTTPS do seu domínio já leva a chave certa.
gpg --export "$CHAVE" | base64 -w0 > "$TRABALHO/chave.b64"
cat > "$REPO/adv-br.flatpakrepo" <<FIM
[Flatpak Repo]
Title=Certificado Digital (adv-br)
Url=$ORIGEM
Homepage=https://github.com/LLawli/flatpak-adv-br
Comment=Certificado digital ICP-Brasil no Linux, sem terminal
Description=Drivers de token, assinadores e PJeOffice, instalados com um clique
GPGKey=$(cat "$TRABALHO/chave.b64")
FIM

cat > "$REPO/index.html" <<FIM
<!doctype html>
<html lang="pt-BR">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Certificado Digital (adv-br)</title>
<style>
 body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto;
        padding: 0 1rem; line-height: 1.6; }
 pre { background: #f4f4f5; padding: 1rem; overflow-x: auto; border-radius: .4rem; }
 @media (prefers-color-scheme: dark) {
   body { background: #18181b; color: #e4e4e7; }
   pre { background: #27272a; }
 }
</style>
<h1>Certificado Digital</h1>
<p>Use o seu certificado ICP-Brasil no Linux: token nos navegadores, assinatura
   nos sistemas do Judiciário e no PJe.</p>
<h2>Instalar</h2>
<pre>flatpak remote-add --if-not-exists adv-br $ORIGEM/adv-br.flatpakrepo
flatpak install adv-br $APP_ID</pre>
<p>Depois é só abrir <strong>Certificado Digital</strong> no menu.</p>
<p><a href="https://github.com/LLawli/flatpak-adv-br">Código e documentação</a></p>
FIM

TAMANHO=$(du -sh "$REPO" | cut -f1)
ok "repositório em $REPO ($TAMANHO)"

# ---------------------------------------------------------------------------
if [ "$ENVIAR" = sim ]; then
    [ -n "$DESTINO" ] || erro "defina ADV_BR_VPS, por exemplo: vps:/home/luka/totalidade/apps/adv-br/repo"
    passo "Enviando para $DESTINO"
    # Só o que mudou atravessa: os objetos do OSTree têm o hash no nome, então
    # o que já está lá não é reenviado.
    rsync -a --delete --info=stats1 "$REPO/" "$DESTINO/"
    ok "enviado"
else
    printf '\n   Para publicar:  ADV_BR_VPS=vps:/home/luka/totalidade/apps/adv-br/repo %s --enviar\n' "$0"
fi

printf '\n   Testar aqui mesmo, como quem instala:\n'
printf '       flatpak remote-add --user --if-not-exists --no-gpg-verify adv-br-local %s\n' "$REPO"
printf '       flatpak install --user adv-br-local %s\n\n' "$APP_ID"
