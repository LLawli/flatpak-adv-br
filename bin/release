#!/usr/bin/env bash
# Solta uma release: confere, versiona, commita, empurra e cria a tag.
#
#   bin/release 0.2.0          pergunta antes de empurrar
#   bin/release 0.2.0 --sim    empurra sem perguntar
#
# O que acontece depois de a tag chegar ao GitHub é com o workflow de release,
# que extrai a seção desta versão do CHANGELOG.md e a usa como corpo do GitHub
# Release. Por isso a seção precisa existir ANTES da tag: escrevê-la é a parte
# que este script se recusa a fazer por você.
#
# O controle de versão é o jj, colocado sobre o git, e é por isso que este
# script empurra, coisa que antes ficava para quem o chamava. Os commits locais
# não são assinados (signing.behavior = "drop"): quem assina é o
# git.sign-on-push, na saída, e assinar REESCREVE o commit. Uma tag criada
# antes do push apontaria para o commit sem assinatura, que nunca chega ao
# GitHub. Então a ordem é: commit, push, e só então a tag, sobre o commit que o
# remoto recebeu.
#
# A tag continua sendo do git (o jj não cria tag assinada nem a empurra), e o
# CHANGELOG.md pode chegar aqui com a seção recém-renomeada: ele entra no mesmo
# commit da versão, como sempre entrou.
set -euo pipefail

cd "$(dirname "$0")/.."

vermelho='' verde='' normal=''
if [ -t 1 ]; then
    vermelho=$(printf '\033[31m') verde=$(printf '\033[32m') normal=$(printf '\033[0m')
fi
log()  { printf '%s==>%s %s\n' "$verde" "$normal" "$1"; }
erro() { printf '%serro:%s %s\n' "$vermelho" "$normal" "$1" >&2; exit 1; }

USO="uso: bin/release <versão> [--sim]   (exemplo: bin/release 0.2.0)"
VERSAO=''
SEM_PERGUNTAR=nao
for argumento in "$@"; do
    case $argumento in
        --sim) SEM_PERGUNTAR=sim ;;
        -*) erro "$USO" ;;
        *) [ -z "$VERSAO" ] || erro "$USO"; VERSAO=$argumento ;;
    esac
done
[ -n "$VERSAO" ] || erro "$USO"

# Sem o "v". A tag ganha o prefixo; o arquivo VERSAO e o CHANGELOG não têm.
[[ $VERSAO =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    erro "versão deve ser X.Y.Z sem o 'v' (recebido: $VERSAO)"

TAG="v$VERSAO"

log "conferindo o estado do repositório"
command -v jj >/dev/null 2>&1 || erro "falta o jj, que é o controle de versão deste repositório."
jj root >/dev/null 2>&1 || erro "não é um repositório jj."
# Sem staging no jj: o que estiver no working copy entra no commit da versão.
# Só o CHANGELOG.md pode estar lá, e é o que o commit da versão sempre levou.
alheios=$(jj diff --name-only -r @ | grep -vx 'CHANGELOG.md' || true)
[ -z "$alheios" ] ||
    erro "o working copy tem mudanças além do CHANGELOG.md:
$alheios
      Feche-as num commit (jj commit) antes de soltar a release."
! git rev-parse -q --verify "refs/tags/$TAG" >/dev/null ||
    erro "a tag $TAG já existe aqui."
[ -z "$(git ls-remote --tags origin "refs/tags/$TAG")" ] ||
    erro "a tag $TAG já existe no GitHub."
# A main do remoto tem de estar na história do que vai sair: senão o push
# não é avanço, e o jj recusaria lá no fim, depois do build inteiro.
[ -n "$(jj log --no-graph -r 'main@origin & ::@' -T 'commit_id')" ] ||
    erro "a main do GitHub não está na história deste working copy.
      Rode jj git fetch e refaça os commits sobre ela."

# O corpo do GitHub Release sai daqui. Uma seção ausente produziria uma release
# vazia, que é exatamente o que este script existe para impedir.
log "conferindo a seção [$VERSAO] no CHANGELOG.md"
# Sem cano: o grep lê o arquivo. Ver docs/ARMADILHAS.md, sobre por que
# 'produtor | grep -q' não serve num script com pipefail.
grep -q "^## \[$VERSAO\]" CHANGELOG.md ||
    erro "CHANGELOG.md não tem a seção '## [$VERSAO]'. Escreva-a antes."

corpo=$(awk -v ver="$VERSAO" '
    BEGIN { hdr = "## [" ver "]" }
    index($0, hdr) == 1 { flag = 1; next }
    flag && index($0, "## [") == 1 { exit }
    flag && /^\[[^]]+\]:[[:space:]]/ { exit }
    flag { print }
' CHANGELOG.md)

[ -n "$(printf '%s' "$corpo" | tr -d '[:space:]')" ] ||
    erro "a seção '## [$VERSAO]' do CHANGELOG.md está vazia."

# Só o manifesto publicado: é o metainfo dele que a loja de aplicativos lê, e
# uma versão sem entrada aqui chega às pessoas como se nada tivesse mudado.
log "conferindo a entrada da versão no metainfo"
grep -q "version=\"$VERSAO\"" dev.lukakuuhaku.AdvBr.metainfo.xml ||
    erro "dev.lukakuuhaku.AdvBr.metainfo.xml não tem a entrada
      <release version=\"$VERSAO\">. Escreva-a antes."

log "rodando as verificações estáticas"
make lint >/dev/null || erro "o lint falhou; corrija antes de soltar a release."

log "conferindo o pacote que está sendo lançado"
# Várias distribuições pararam de empacotar o flatpak-builder, e o próprio
# projeto passou a recomendar o do Flathub. Os dois servem; o do Flathub
# precisa enxergar este diretório, e por isso o --filesystem.
#
# O estado e o build moram juntos em $TRABALHO, e não no .flatpak-builder do
# repositório: o flatpak-builder recusa estado e build em sistemas de arquivos
# diferentes, e o .flatpak-builder pode ser um symlink para outro disco.
TRABALHO=${ADV_BR_TRABALHO:-${XDG_CACHE_HOME:-$HOME/.cache}/adv-br-publicacao}
mkdir -p "$TRABALHO"
if command -v flatpak-builder >/dev/null 2>&1; then
    CONSTRUTOR=(flatpak-builder)
elif flatpak info org.flatpak.Builder >/dev/null 2>&1; then
    CONSTRUTOR=(flatpak run --filesystem="$PWD" --filesystem="$TRABALHO" org.flatpak.Builder)
else
    erro "flatpak-builder não encontrado; não dá para conferir o que está sendo
      lançado. Instale-o pela sua distribuição ou com
          flatpak install flathub org.flatpak.Builder"
fi
# O manifesto conferido é o PUBLICADO, e não o que o ./instalar.sh constrói.
# São dois pacotes com runtimes diferentes, e quem recebe uma versão nova pelo
# repositório é este: uma tag que produzisse um pacote quebrado aqui chegaria a
# todo mundo de uma vez, enquanto quem clona e constrói vê o erro na própria
# máquina, antes de instalar coisa nenhuma.
#
# O que fica descoberto: o io.github.llawli.AdvBr.yml não é construído por
# ninguém antes da tag. O CI confere os manifestos por fora (id, tabulação,
# fontes citadas) e não constrói nenhum dos dois.
"${CONSTRUTOR[@]}" --user --force-clean --disable-rofiles-fuse \
    --state-dir "$TRABALHO/estado" \
    "$TRABALHO/conferencia" dev.lukakuuhaku.AdvBr.yml >/dev/null ||
    erro "o pacote publicado não constrói; não vou marcar uma versão quebrada."
rm -rf "$TRABALHO/conferencia"

# Uma execução que parou depois do commit (sem terminal para a pergunta, ou um
# toque que não veio) deixa o commit da versão como pai do working copy. Rodar
# de novo retoma dali: commitar outra vez criaria um segundo "Marca a versão",
# vazio, e é ele que levaria a tag.
if [ "$(jj log --no-graph -r @- -T 'description.first_line()')" = "Marca a versão $VERSAO" ] &&
    [ "$(git show "$(jj log --no-graph -r @- -T 'commit_id')":VERSAO)" = "$VERSAO" ] &&
    [ -z "$(jj diff --name-only -r @)" ]; then
    log "o commit da versão já existe, de uma execução anterior; seguindo dele"
else
    log "gravando a versão"
    printf '%s\n' "$VERSAO" > VERSAO
    jj commit -m "Marca a versão $VERSAO" VERSAO CHANGELOG.md >/dev/null
fi
jj bookmark set main -r @- >/dev/null

# Cada commit que sai é assinado na YubiKey, um toque por commit. A contagem
# vai antes, para a espera pelo toque não parecer travamento; o
# ssh-keygen-avisando numera as notificações com ela.
TOQUE_TOTAL=$(jj log --no-graph -r 'main@origin..main' -T 'commit_id ++ "\n"' | grep -c .)
[ "$TOQUE_TOTAL" -ge 1 ] || erro "nada novo para empurrar, e a versão acabou de ser commitada?"
export TOQUE_TOTAL
printf '\n'
jj log -r 'main@origin..main' --no-graph \
    -T 'change_id.short() ++ "  " ++ description.first_line() ++ "\n"'
printf '\n%s commit(s) para assinar no push, e mais um toque para a tag.\n' "$TOQUE_TOTAL"
if [ "$SEM_PERGUNTAR" != sim ]; then
    # Um comando lançado por outro programa, ou por um cano, não tem terminal
    # no stdin. Rodar de novo com --sim retoma do commit da versão, sem
    # refazê-lo.
    [ -t 0 ] || erro "sem terminal para perguntar. Confira a lista acima e rode de novo
      com --sim: o script retoma do commit da versão, sem refazê-lo.
      Para desistir, jj undo desfaz o commit."
    read -r -p "Empurrar a main e criar a tag $TAG? [s/N] " resposta
    [ "$resposta" = s ] || [ "$resposta" = S ] ||
        erro "nada foi empurrado. O commit da versão ficou local: jj undo desfaz."
fi

log "empurrando a main"
jj git push --bookmark main ||
    erro "o push falhou (toque não recebido a tempo?), e a tag não foi criada.
      Empurre de novo com jj git push --bookmark main e crie a tag à mão."

# A tag vai no commit que o GitHub recebeu, já assinado, e não no que este
# working copy tinha antes do push. As duas conferências são o motivo da ordem.
publicado=$(jj log --no-graph -r 'main@origin' -T 'commit_id')
[ "$(git show "$publicado:VERSAO")" = "$VERSAO" ] ||
    erro "o commit da main no GitHub ($publicado) não tem a versão $VERSAO."
git cat-file -p "$publicado" | grep -q '^gpgsig ' ||
    erro "o commit $publicado chegou ao GitHub sem assinatura; não vou marcá-lo."

log "criando a tag $TAG"
git tag -s -a "$TAG" -m "$VERSAO

$corpo" "$publicado"
git push origin "$TAG"

printf '\n%s==>%s pronto: %s está no GitHub, e o workflow de release segue dali.\n\n' \
    "$verde" "$normal" "$TAG"
