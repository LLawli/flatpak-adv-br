#!/usr/bin/env bash
# Solta uma release: confere, versiona, commita e cria a tag.
#
#   bin/release 0.2.0
#
# O que acontece depois de a tag chegar ao GitHub é com o workflow de release,
# que extrai a seção desta versão do CHANGELOG.md e a usa como corpo do GitHub
# Release. Por isso a seção precisa existir ANTES da tag: escrevê-la é a parte
# que este script se recusa a fazer por você.
set -euo pipefail

cd "$(dirname "$0")/.."

vermelho='' verde='' normal=''
if [ -t 1 ]; then
    vermelho=$(printf '\033[31m') verde=$(printf '\033[32m') normal=$(printf '\033[0m')
fi
log()  { printf '%s==>%s %s\n' "$verde" "$normal" "$1"; }
erro() { printf '%serro:%s %s\n' "$vermelho" "$normal" "$1" >&2; exit 1; }

[ $# -eq 1 ] || erro "uso: bin/release <versão>   (exemplo: bin/release 0.2.0)"
VERSAO=$1

# Sem o "v". A tag ganha o prefixo; o arquivo VERSAO e o CHANGELOG não têm.
[[ $VERSAO =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    erro "versão deve ser X.Y.Z sem o 'v' (recebido: $VERSAO)"

TAG="v$VERSAO"

log "conferindo o estado do repositório"
git rev-parse --git-dir >/dev/null 2>&1 || erro "não é um repositório git."
[ -z "$(git status --porcelain)" ] ||
    erro "há alterações não commitadas. Commite ou guarde antes de soltar a release."
! git rev-parse -q --verify "refs/tags/$TAG" >/dev/null ||
    erro "a tag $TAG já existe."

# O corpo do GitHub Release sai daqui. Uma seção ausente produziria uma release
# vazia, que é exatamente o que este script existe para impedir.
log "conferindo a seção [$VERSAO] no CHANGELOG.md"
# Sem cano: o grep lê o arquivo. Ver docs/ARMADILHAS.md, sobre por que
# 'produtor | grep -q' não serve num script com pipefail.
grep -q "^## \[$VERSAO\]" CHANGELOG.md ||
    erro "CHANGELOG.md não tem a seção '## [$VERSAO]'. Escreva-a antes."

corpo=$(awk -v ver="$VERSAO" '
    BEGIN { hdr = "## [" ver "]" }
    index($0, hdr) == 1 { flag = 1; next }
    flag && index($0, "## [") == 1 { exit }
    flag && /^\[[^]]+\]:[[:space:]]/ { exit }
    flag { print }
' CHANGELOG.md)

[ -n "$(printf '%s' "$corpo" | tr -d '[:space:]')" ] ||
    erro "a seção '## [$VERSAO]' do CHANGELOG.md está vazia."

# Só o manifesto publicado: é o metainfo dele que a loja de aplicativos lê, e
# uma versão sem entrada aqui chega às pessoas como se nada tivesse mudado.
log "conferindo a entrada da versão no metainfo"
grep -q "version=\"$VERSAO\"" dev.lukakuuhaku.AdvBr.metainfo.xml ||
    erro "dev.lukakuuhaku.AdvBr.metainfo.xml não tem a entrada
      <release version=\"$VERSAO\">. Escreva-a antes."

log "rodando as verificações estáticas"
make lint >/dev/null || erro "o lint falhou; corrija antes de soltar a release."

log "conferindo o pacote que está sendo lançado"
# Várias distribuições pararam de empacotar o flatpak-builder, e o próprio
# projeto passou a recomendar o do Flathub. Os dois servem; o do Flathub
# precisa enxergar este diretório, e por isso o --filesystem.
#
# O estado e o build moram juntos em $TRABALHO, e não no .flatpak-builder do
# repositório: o flatpak-builder recusa estado e build em sistemas de arquivos
# diferentes, e o .flatpak-builder pode ser um symlink para outro disco.
TRABALHO=${ADV_BR_TRABALHO:-${XDG_CACHE_HOME:-$HOME/.cache}/adv-br-publicacao}
mkdir -p "$TRABALHO"
if command -v flatpak-builder >/dev/null 2>&1; then
    CONSTRUTOR=(flatpak-builder)
elif flatpak info org.flatpak.Builder >/dev/null 2>&1; then
    CONSTRUTOR=(flatpak run --filesystem="$PWD" --filesystem="$TRABALHO" org.flatpak.Builder)
else
    erro "flatpak-builder não encontrado; não dá para conferir o que está sendo
      lançado. Instale-o pela sua distribuição ou com
          flatpak install flathub org.flatpak.Builder"
fi
# O manifesto conferido é o PUBLICADO, e não o que o ./instalar.sh constrói.
# São dois pacotes com runtimes diferentes, e quem recebe uma versão nova pelo
# repositório é este: uma tag que produzisse um pacote quebrado aqui chegaria a
# todo mundo de uma vez, enquanto quem clona e constrói vê o erro na própria
# máquina, antes de instalar coisa nenhuma.
#
# O que fica descoberto: o io.github.llawli.AdvBr.yml não é construído por
# ninguém antes da tag. O CI confere os manifestos por fora (id, tabulação,
# fontes citadas) e não constrói nenhum dos dois.
"${CONSTRUTOR[@]}" --user --force-clean --disable-rofiles-fuse \
    --state-dir "$TRABALHO/estado" \
    "$TRABALHO/conferencia" dev.lukakuuhaku.AdvBr.yml >/dev/null ||
    erro "o pacote publicado não constrói; não vou marcar uma versão quebrada."
rm -rf "$TRABALHO/conferencia"

log "gravando a versão"
printf '%s\n' "$VERSAO" > VERSAO
git add VERSAO CHANGELOG.md
# Assinado, como todo commit deste repositório: um commit sem assinatura no
# meio da história é um buraco que não se tapa depois.
git commit -q -S -m "Marca a versão $VERSAO"

log "criando a tag $TAG"
git tag -s -a "$TAG" -m "$VERSAO

$corpo"

printf '\n%s==>%s pronto. Falta empurrar:\n\n    git push && git push origin %s\n\n' \
    "$verde" "$normal" "$TAG"
