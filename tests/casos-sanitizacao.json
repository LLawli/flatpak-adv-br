    {
      "nome": "o diagnostico util sobrevive inteiro",
      "entrada": "18:20:45 pkcs11: C_GetSlotList devolveu 0x30; serie do host 0.25, do pacote 0.26",
      "some": [],
      "fica": ["C_GetSlotList", "0x30", "0.25", "0.26", "pkcs11", "18:20:45"]
