#!/bin/sh
# Lançador dos assinadores, chamado pelo navegador por native messaging.
#
# O navegador executa um atalho na home de quem usa, o atalho chama
#
#   flatpak run --command=adv-br-assinador dev.lukakuuhaku.AdvBr <chave> [origem]
#
# e conversa com o assinador por stdin/stdout, no protocolo de native
# messaging: 4 bytes de tamanho, little-endian, mais um JSON.
#
# NADA em stdout que não venha do assinador. Uma linha de log ali corrompe o
# protocolo, e o sintoma no navegador é "o assinador não respondeu".
set -eu

# O nome do módulo sai do primeiro argumento, antes de validá-lo: assim até
# uma chamada errada fica registrada, que é o caso em que mais se precisa saber
# o que houve. O registro.sh limpa o que vier daí.
ADV_BR_MODULO="assinador-${1:-sem-chave}"
# shellcheck source=ui/registro.sh
. /app/share/adv-br-ui/registro.sh

CHAVE=${1:-}
if [ -z "$CHAVE" ]; then
    echo "uso: adv-br-assinador <chave> [argumentos do navegador]" >&2
    exit 2
fi
shift

COMPONENTES="${XDG_DATA_HOME:-$HOME/.local/share}/componentes"
ASSINADOR="$COMPONENTES/$CHAVE/bin/$CHAVE"

if [ ! -x "$ASSINADOR" ]; then
    echo "adv-br: o assinador '$CHAVE' não está instalado." >&2
    echo "     Abra o Certificado Digital e instale-o." >&2
    exit 1
fi

# Ver ui/preparar-drivers.sh: bibliotecas de apoio dos componentes e os
# remendos que os drivers proprietários exigem antes de serem abertos. Define
# COMPONENTES.
. /app/share/adv-br-ui/preparar-drivers.sh

# Os drivers que a pessoa instalou pela janela. Sem isto, o assinador abre,
# conversa e lista ZERO certificados.
#
# O p11-kit deste sandbox só conhece o que estiver em /etc/pkcs11/modules, que é
# um tmpfs recriado a cada execução: nenhum driver existe até que alguém escreva
# os .module. A ponte PKCS#11 não precisa disto, porque recebe o caminho do
# módulo pronto; o assinador precisa, porque o que ele recebe é
# /pkcs11/adv-br.so, e esse caminho responde pelo p11-kit-proxy — que sem
# registro não tem o que oferecer.
#
# O sintoma não parece encanamento: a extensão do navegador conecta, o
# getVersion responde, e a lista de certificados volta vazia, como se o token
# não estivesse espetado.
#
# Nada em stdout: ali corre o protocolo de native messaging, e um byte a mais o
# corrompe. Daí o >&2.
PYTHONPATH=/app/share/adv-br-ui python3 -c 'import pkcs11; pkcs11.registrar()' >&2 ||
    echo "adv-br: não deu para registrar os drivers no p11-kit." >&2

# O Certisign abre os .glade da interface por caminho absoluto em
# /opt/certisign-websigner/res, e não há como redirecioná-lo. A raiz do sandbox
# é um tmpfs gravável, então o caminho que ele espera é criado aqui e some com
# a execução, o que é mais honesto que remendar a string dentro do binário.
if [ "$CHAVE" = certisign ] && [ -d "$COMPONENTES/certisign/res" ]; then
    mkdir -p /opt/certisign-websigner
    ln -sfn "$COMPONENTES/certisign/res" /opt/certisign-websigner/res
fi

exec "$ASSINADOR" "$@"
