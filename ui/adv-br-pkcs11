#!/bin/sh
# A ponte PKCS#11 para fora: exporta um módulo deste aplicativo pelo
# stdin/stdout.
#
# Quem executa isto é o p11-kit do HOST, a partir do .module que o aplicativo
# escreveu na home de quem usa:
#
#   remote: |flatpak run --command=adv-br-pkcs11 dev.lukakuuhaku.AdvBr <módulo>
#
# O p11-kit-proxy do host inicia este comando sob demanda e conversa com ele
# pelo pipe. É assim que um navegador que roda fora do sandbox enxerga um
# driver que só existe dentro dele.
#
# NÃO ESCREVA NADA EM STDOUT AQUI. O stdout é o protocolo RPC do p11-kit;
# qualquer byte a mais o corrompe. Mensagens vão para stderr.
set -eu

# O stderr deste processo vai para o log do módulo. Precisa vir antes de tudo:
# o que for escrito antes disto se perde onde sempre se perdeu, dentro do
# processo que nos iniciou. Ver ui/registro.sh.
ADV_BR_MODULO=pkcs11
# shellcheck source=ui/registro.sh
. /app/share/adv-br-ui/registro.sh

# O relógio começa antes do preparo: é ele que se quer medir, e o preparo vem
# antes de qualquer decisão sobre qual p11-kit usar.
INICIO=$(date +%s%3N 2>/dev/null || echo 0)
case "$INICIO" in ''|*[!0-9]*) INICIO=0 ;; esac

MODULO=${1:-}
if [ -z "$MODULO" ]; then
    echo "uso: adv-br-pkcs11 <caminho-do-modulo.so>" >&2
    exit 2
fi

if [ ! -e "$MODULO" ]; then
    echo "adv-br: o driver $MODULO não está instalado neste aplicativo." >&2
    echo "     Abra o Certificado Digital e instale-o, ou publique de novo." >&2
    exit 1
fi

# Ver ui/preparar-drivers.sh: bibliotecas de apoio dos componentes e os
# remendos que os drivers proprietários exigem antes de serem abertos. Define
# COMPONENTES.
. /app/share/adv-br-ui/preparar-drivers.sh

# Quando o p11-kit do host está numa série diferente da do runtime, a pessoa
# instala pela janela um p11-kit da série dele, e é ELE que a ponte usa. As
# duas pontas precisam concordar sobre a tabela de funções que trafega no pipe;
# quando não concordam, nada recusa a conexão, os slots enumeram, o PIN é
# aceito e toda assinatura falha. Ver docs/ARMADILHAS.md.
#
# Só este processo o usa. Os assinadores e o PJeOffice continuam com o p11-kit
# do runtime, e não precisam concordar com ninguém porque não atravessam pipe
# nenhum: por isso o LD_LIBRARY_PATH abaixo é exportado aqui, e não no preparo
# comum.
#
# O binário chamado é o p11-kit-remote, e não "p11-kit remote": o "p11-kit"
# procura o auxiliar por um caminho absoluto gravado nele em tempo de
# compilação, que não existe quando o pacote é instalado nos dados do
# aplicativo. Chamar o auxiliar direto faz o mesmo trabalho e não depende
# de onde o componente foi parar.
# O laço escolhe e o exec vem depois, fora dele. Um exec dentro do laço é
# apontado pelo SC2093 e, pior que o aviso, esconde de quem lê que o script
# termina ali.
COMPAT=""
for candidato in "$COMPONENTES"/p11kit-*/; do
    [ -x "$candidato/libexec/p11-kit/p11-kit-remote" ] || continue
    COMPAT=$candidato
    break
done

# Daqui para baixo, o log. Ele existe por um relato: "o Firefox demorou muito
# para responder a tela de login do gov.br", e o diagnóstico que veio junto
# trazia três marcadores de sessão desta ponte, vazios. Ou seja: ela subiu três
# vezes e não disse qual módulo carregou, com qual p11-kit, nem quanto tempo
# levou. Não dava para responder nada.
#
# Nada em stdout: ali corre o RPC do p11-kit, e um byte a mais o corrompe.
agora_ms() {
    ms=$(date +%s%3N 2>/dev/null || true)
    case "$ms" in
        ''|*[!0-9]*) echo 0 ;;
        *) echo "$ms" ;;
    esac
}
ABERTURA=$(agora_ms)

if [ -n "$COMPAT" ]; then
    export LD_LIBRARY_PATH="$COMPAT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    REMOTO="$COMPAT/libexec/p11-kit/p11-kit-remote"
    QUAL="compatibilidade $(basename "${COMPAT%/}")"
else
    # O binário do runtime. Chamado como "p11-kit remote", que é o que existe
    # quando não há componente de compatibilidade instalado.
    REMOTO=""
    QUAL="p11-kit do runtime"
fi

echo "módulo: $MODULO" >&2
echo "p11-kit: $QUAL" >&2
[ "$INICIO" = 0 ] || [ "$ABERTURA" = 0 ] ||
    echo "preparo: $((ABERTURA - INICIO)) ms" >&2

# Sem exec, e é de propósito: o exec troca este processo pelo p11-kit-remote, e
# aí não há mais ninguém para anotar quanto tempo a sessão durou nem como ela
# terminou — que é justamente o que faltava no relato. O custo é um /bin/sh
# parado enquanto o navegador mantiver o módulo aberto.
if [ -n "$REMOTO" ]; then
    "$REMOTO" "$MODULO" || CODIGO=$?
else
    p11-kit remote "$MODULO" || CODIGO=$?
fi
CODIGO=${CODIGO:-0}

FIM=$(agora_ms)
if [ "$FIM" != 0 ] && [ "$ABERTURA" != 0 ]; then
    echo "encerrou com código $CODIGO, depois de $((FIM - ABERTURA)) ms" >&2
else
    echo "encerrou com código $CODIGO" >&2
fi
exit "$CODIGO"
