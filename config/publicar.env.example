# Copie para config/publicar.env (fora do controle de versão) e preencha.

# O id da chave GPG que assina o remote (gpg --list-secret-keys).
ANCORA_CHAVE_GPG=
# Para onde o --enviar manda o repositório, como o rsync entende.
ANCORA_DESTINO=usuario@servidor:/caminho/do/repo
# O repositório local, compartilhado com o AdvBr até o fim da migração.
#ANCORA_REPO=$HOME/.local/share/adv-br-repo
# Onde ficam os builds da publicação.
#ANCORA_TRABALHO=$HOME/.cache/ancora-publicacao
# Só para testar com outra chave: a chave pública que o repositório anuncia.
#ANCORA_CHAVE_PUBLICA=packaging/chave-publica.asc
